APP_ENV=development
APP_DEBUG=false
APP_NAME=CELTM Phase 1 API

# Comma-separated browser origins allowed by FastAPI CORS.
FRONTEND_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# Supabase student auth and question-bank access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_SECRET_KEY=
SUPABASE_KEY=

# Local development uses SQLite when these are blank.
# Hosted mode must use Postgres/Supabase Postgres.
DATABASE_URL=
SUPABASE_DATABASE_URL=
SUPABASE_DB_CONNECTION_STRING=
CELTM_POSTGRES_SCHEMA=celtm_app

# AI features are unavailable unless OPENAI_API_KEY is set.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ALLOW_HEURISTIC_AI_FALLBACKS=false

# Production upload storage. Use local only for development.
STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=celtm-private-uploads
SUPABASE_STORAGE_CREATE_BUCKET=false
SIGNED_URL_TTL_SECONDS=900
ALLOW_LOCAL_FILE_SERVING=true

# Upload validation limits.
MAX_AVATAR_UPLOAD_BYTES=5242880
MAX_RESUME_UPLOAD_BYTES=10485760
MAX_ARTIFACT_UPLOAD_BYTES=20971520
MAX_CSV_UPLOAD_BYTES=5242880
MAX_EXTRACTED_TEXT_CHARS=120000

# External profile-link crawler limits.
PROFILE_LINK_MAX_BYTES=524288
PROFILE_LINK_TIMEOUT_SECONDS=8
PROFILE_LINK_MAX_REDIRECTS=3

# API abuse controls.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_GENERAL_PER_MINUTE=600
RATE_LIMIT_ADMIN_LOGIN_PER_15M=5
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_AI_PER_HOUR=30
RATE_LIMIT_AI_GLOBAL_PER_MINUTE=120
RATE_LIMIT_ASSESSMENT_PER_MINUTE=180

# AI cost and latency controls.
OPENAI_TIMEOUT_SECONDS=35
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=86400
AI_CACHE_MAX_ENTRIES=2000
ASYNC_AI_JOBS_ENABLED=false

# Optional hosted malware scanning. Keep disabled for local development unless
# ClamAV is running.
UPLOAD_SCAN_ENABLED=false
CLAMAV_TCP_HOST=
CLAMAV_TCP_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8
FAIL_CLOSED_UPLOAD_SCAN=true

# Hosted monitoring and admin MFA.
MONITORING_TOKEN=
ADMIN_MFA_REQUIRED=false
ADMIN_MFA_SECRET=

# Local defaults are for development only. Hosted mode rejects these values.
ADMIN_USER=admin@celtm.com
ADMIN_PASS=admin123
ADMIN_GATEWAY_CODE=CELTM2026
CELTM_JWT_SECRET=

# Local runtime data path.
CELTM_DATA_DIR=data
