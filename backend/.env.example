APP_ENV=development
APP_DEBUG=true
FRONTEND_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_CONNECTION_STRING=

# Backward-compatible aliases accepted by the backend if your local env already uses them.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Celery does not need its own account, API key, or hosted credential.
# For production, point these Redis variables at a managed Redis instance such as
# Upstash, Redis Cloud, ElastiCache, Azure Cache for Redis, or a self-hosted Redis.
# Use rediss://... if your provider requires TLS.
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_FAIL_OPEN=false
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.2
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Optional override if workers should use a different Redis broker than REDIS_URL.
CELERY_BROKER_URL=
# Optional override if Celery results should be stored in a different Redis instance.
CELERY_RESULT_BACKEND=
CELERY_EAGER_MODE=false
CELTMIND_DIR=../CELTMIND
# Set false on hosted deployments that do not mount the CELTMIND CSV folder.
CELTMIND_SYNC_ENABLED=true

PROFILE_BUCKET=profile-assets
ARTIFACT_BUCKET=career-artifacts

AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
READ_RATE_LIMIT=120
READ_RATE_WINDOW_SECONDS=60
MUTATION_RATE_LIMIT=30
MUTATION_RATE_WINDOW_SECONDS=60
AI_RATE_LIMIT=5
AI_RATE_WINDOW_SECONDS=60
AI_DAILY_LIMIT=50
AI_DAILY_WINDOW_SECONDS=86400
