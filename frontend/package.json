{
  "name": "celtm-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo --hostname 127.0.0.1",
    "dev:lite": "next dev --hostname 127.0.0.1",
    "dev:safe": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --hostname 127.0.0.1",
    "clean": "rimraf .next node_modules/.cache",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:logic": "node --test tests/logical-benchmark.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.7",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
