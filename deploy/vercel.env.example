# CELTM Vercel frontend environment template
# Set these in the Vercel project created with root directory `frontend`.

NEXT_PUBLIC_API_BASE_URL=https://your-render-backend.onrender.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Alternative name supported by the frontend if you prefer Supabase's newer
# publishable key label.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
