# CELTM hosted environment template
# Keep real values in the hosting provider secret store, not in Git.

APP_ENV=production
PYTHON_VERSION=3.12.8
FRONTEND_ORIGIN=https://your-frontend-domain

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

DATABASE_URL=postgresql://user:password@host:5432/database
CELTM_POSTGRES_SCHEMA=celtm_app

STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=celtm-private-uploads
SUPABASE_STORAGE_CREATE_BUCKET=false
ALLOW_LOCAL_FILE_SERVING=false
SIGNED_URL_TTL_SECONDS=900

RATE_LIMIT_ENABLED=true
# Free single-instance Render can use memory. Use redis + REDIS_URL when you add
# shared Redis/Upstash or scale beyond one backend instance.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_GENERAL_PER_MINUTE=600
RATE_LIMIT_ADMIN_LOGIN_PER_15M=5
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_AI_PER_HOUR=30
RATE_LIMIT_AI_GLOBAL_PER_MINUTE=120
RATE_LIMIT_ASSESSMENT_PER_MINUTE=180

AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=86400
AI_CACHE_MAX_ENTRIES=2000
OPENAI_TIMEOUT_SECONDS=35
ASYNC_AI_JOBS_ENABLED=false

UPLOAD_SCAN_ENABLED=false
CLAMAV_TCP_HOST=
CLAMAV_TCP_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8
FAIL_CLOSED_UPLOAD_SCAN=true

MONITORING_TOKEN=generate-a-strong-random-token
ADMIN_MFA_REQUIRED=false
ADMIN_MFA_SECRET=

ADMIN_USER=security-admin@example.com
ADMIN_PASS=generate-a-strong-random-password
ADMIN_GATEWAY_CODE=generate-a-strong-random-code
CELTM_JWT_SECRET=generate-a-strong-random-secret

OPENAI_API_KEY=your-openai-key
OPENAI_CHAT_MODEL=gpt-4o-mini
ALLOW_HEURISTIC_AI_FALLBACKS=false
